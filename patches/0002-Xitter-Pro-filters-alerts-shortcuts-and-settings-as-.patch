+	var CONTENT = { all: "All posts", media: "With media", images: "With images", videos: "With videos", links: "With links", quote: "Quotes" };
+	var filtered = function (c) {
+		var f = c && c.filters;
+		return !!f && ((f.content && f.content !== "all") || (f.replies && f.replies !== "include") || f.follows || f.faves > 0 || f.reposts > 0 || f.answers > 0 || f.top);
+	};
+	function filterQuery(base, f) {
+		var q = [base];
+		f = f || {};
+		if (f.content && f.content !== "all") q.push("filter:" + f.content);
+		if (f.replies === "exclude") q.push("-filter:replies");
+		if (f.replies === "only") q.push("filter:replies");
+		if (f.follows && base.indexOf("filter:follows") < 0) q.push("filter:follows");
+		if (f.faves > 0) q.push("min_faves:" + f.faves);
+		if (f.reposts > 0) q.push("min_retweets:" + f.reposts);
+		if (f.answers > 0) q.push("min_replies:" + f.answers);
+		return q.join(" ").trim();
+	}
+	function searchPath(base, c) {
+		var f = (c && c.filters) || {};
+		return "/search?q=" + encodeURIComponent(filterQuery(base, f)) + "&src=typed_query" + (f.top ? "" : "&f=live");
+	}
+	function filterChips(c) {
+		var f = c.filters || {}, out = [];
+		if (f.content && f.content !== "all") out.push(CONTENT[f.content]);
+		if (f.replies === "exclude") out.push("No replies");
+		if (f.replies === "only") out.push("Only replies");
+		if (f.follows) out.push("People you follow");
+		if (f.faves > 0) out.push(f.faves + "+ likes");
+		if (f.reposts > 0) out.push(f.reposts + "+ reposts");
+		if (f.answers > 0) out.push(f.answers + "+ replies");
+		if (f.top) out.push("Top");
+		return out;
+	}
