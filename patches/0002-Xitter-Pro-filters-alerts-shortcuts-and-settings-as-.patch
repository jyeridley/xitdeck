+	// The client puts the unread count in its page title, "(3) Home / X": the
+	// deck shows it on its notification columns and in its own title, and says
+	// so on the desktop when it goes up
+	var count = 0;
+	function unread(title) {
+		var m = /^\((\d+)(\+?)\)/.exec(title || "");
+		var n = m ? Number(m[1]) : 0;
+		if (n === count) return;
+		var more = n > count;
+		count = n;
+		document.title = (n ? "(" + n + (m[2] || "") + ") " : "") + CFG.instance + " Pro";
+		document.querySelectorAll(".col").forEach(function (el) {
+			var c = deck().columns.filter(function (x) { return x.id === el.dataset.id; })[0];
+			var b = el.querySelector(".unread");
+			if (!c || !(TYPES[c.type] || {}).unread || !b) return;
+			b.textContent = n + (m && m[2] ? "+" : "");
+			b.hidden = !n;
+		});
+		if (!more) return;
+		if (state.prefs.sound) beep();
+		if (state.prefs.notify && document.hidden && window.Notification && Notification.permission === "granted") {
+			try {
+				var note = new Notification(CFG.instance + " Pro", { body: n === 1 ? "You have a new notification" : "You have " + n + " new notifications", icon: ORIGIN + "/public/favicon.png", tag: "xitter-pro" });
+				note.onclick = function () { window.focus(); note.close(); };
+			} catch (err) {}
+		}
+	}
+	var audio = null;
+	function beep() {
+		try {
+			audio = audio || new (window.AudioContext || window.webkitAudioContext)();
+			var o = audio.createOscillator(), g = audio.createGain();
+			o.frequency.value = 880;
+			g.gain.setValueAtTime(0.0001, audio.currentTime);
+			g.gain.exponentialRampToValueAtTime(0.15, audio.currentTime + 0.02);
